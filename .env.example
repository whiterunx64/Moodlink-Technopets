# Application identity and environment
APP_NAME=Moodlink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Locale and faker settings
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

# Log output channel and verbosity
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL database connection via Supabase pooler
DB_CONNECTION=pgsql
DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
DB_PORT=6543 # default pooler port
DB_DATABASE=postgres
DB_USERNAME=nil
DB_PASSWORD=nil
DB_SSLMODE=require

# Cache store. Use "database" so the single-active-session lock and rate-limit
# counters are shared across instances; "file" only works on a single server.
CACHE_STORE=database

QUEUE_CONNECTION=sync

# Session storage. Use "database" for multi-instance deployments (shared session
# store behind a load balancer); "file" only works on a single server.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false   # set true in production (HTTPS only)
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_EXPIRE_ON_CLOSE=false

# Supabase project URL and API keys
SUPABASE_URL=nil
SUPABASE_ANON_KEY=nil
SUPABASE_SERVICE_KEY=nil
SUPABASE_JWT_SECRET=nil

# JWT algorithm, clock skew tolerance, and token expiry durations
SUPABASE_JWT_ALGORITHM=nil # check enum jwt algo
SUPABASE_JWT_LEEWAY=60
SUPABASE_JWT_TTL=3600
SUPABASE_JWT_REFRESH_TTL=604800

# Where users land after login / logout (session lifetime is SESSION_LIFETIME above)
SUPABASE_AUTH_PROVIDER_REDIRECT=/dashboard
SUPABASE_AUTH_LOGOUT_REDIRECT=/

# Password rules enforced on password set/change
SUPABASE_PASSWORD_MIN_LENGTH=8
SUPABASE_PASSWORD_REQUIRE_UPPERCASE=false
SUPABASE_PASSWORD_REQUIRE_LOWERCASE=false
SUPABASE_PASSWORD_REQUIRE_NUMBERS=false
SUPABASE_PASSWORD_REQUIRE_SYMBOLS=false

# Set rate limiting attempt, supabase db lock count
SUPABASE_RATE_LIMITING_ENABLED=true
SUPABASE_LOGIN_MAX_ATTEMPTS=15
SUPABASE_LOGIN_LOCK_MINUTES=60

# Failure threshold before opening circuit and recovery timeout in seconds
SUPABASE_CIRCUIT_BREAKER_ENABLED=true
SUPABASE_CB_FAILURE_THRESHOLD=5
SUPABASE_CB_RECOVERY_TIMEOUT=60

# Cache store, TTLs per data type and key prefix
SUPABASE_CACHE_ENABLED=true
SUPABASE_CACHE_STORE=database
SUPABASE_CACHE_USER_TTL=300
SUPABASE_CACHE_JWT_TTL=60
SUPABASE_CACHE_PREFIX=supabase_auth

# HTTP timeouts, retry behavior, SSL verification and connection pooling
SUPABASE_HTTP_TIMEOUT=10.0
SUPABASE_HTTP_CONNECT_TIMEOUT=5.0
SUPABASE_HTTP_RETRY_ATTEMPTS=3
SUPABASE_HTTP_RETRY_DELAY=1000
SUPABASE_HTTP_VERIFY_SSL=true
SUPABASE_HTTP_USER_AGENT=WHOAMI
SUPABASE_HTTP_POOL_SIZE=10

# Monitoring: logging channel and health check endpoint
SUPABASE_MONITORING_ENABLED=true
SUPABASE_LOG_CHANNEL=stack
SUPABASE_ADMIN_LOG_CHANNEL=stack
SUPABASE_LOG_LEVEL=info
SUPABASE_HEALTH_CHECKS_ENABLED=true
SUPABASE_HEALTH_ENDPOINT=/health/supabase
SUPABASE_HEALTH_INTERVAL=30

# Mail delivery. 
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@moodlink.com
MAIL_FROM_NAME="${APP_NAME}"

# Shared secret required by scheduled/cron HTTP endpoints.
CRON_KEY=

MOODLINK_APK_URL=
MOODLINK_APK_VERSION=4.0.0
MOODLINK_APK_SIZE="87.21 MB"
MOODLINK_APK_MIN_OS="Android 8.0+"
MOODLINK_APK_UPDATED="Jul 07 2026"